# ============================================================
# Meta / WhatsApp
# ============================================================

# Token de verificacion que TU eliges (debe coincidir con el configurado
# en Meta App Dashboard al dar de alta el webhook). Cualquier cadena sirve.
# Ejemplo: WHATSAPP_VERIFY_TOKEN=miclinica_verify_8f3a2b
WHATSAPP_VERIFY_TOKEN=cambia_este_valor

# Access token permanente del System User de Meta Business (Cloud API).
# Formato real: empieza por "EAA" y tiene 200+ caracteres. Se genera en
# Meta Business Suite > Configuracion del negocio > Usuarios del sistema.
# Ejemplo de FORMATO (no es una clave real, no funciona):
# WHATSAPP_ACCESS_TOKEN=EAAGm0PX4ZCpsBO1a2B3c4D5e6F7g8H9i0J1k2L3m4N5o6P7q8R9s0T1u2V3w4X5y6Z7...
WHATSAPP_ACCESS_TOKEN=

# ID del numero de telefono de WhatsApp Business (Phone Number ID, NO el numero en si).
# Es numerico, se ve en Meta > WhatsApp > Configuracion de la API > Phone number ID.
# Ejemplo de FORMATO: WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_PHONE_NUMBER_ID=

# Version de la Graph API a usar
WHATSAPP_API_VERSION=v21.0

# App Secret de tu app de Meta (Meta App Dashboard > Configuracion basica > Clave secreta
# de la app). Es un hexadecimal de 32 caracteres. Se usa para verificar la firma
# X-Hub-Signature-256 de cada webhook entrante.
# Ejemplo de FORMATO (no es una clave real): APP_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
APP_SECRET=

# ============================================================
# Anthropic
# ============================================================

# API key de Anthropic (console.anthropic.com > API Keys > Create Key).
# Formato real: empieza por "sk-ant-api03-".
# Ejemplo de FORMATO (no es una clave real, no funciona):
# ANTHROPIC_API_KEY=sk-ant-api03-AbCdEfGhIjKlMnOpQrStUvWxYz0123456789_AbCdEfGhIjKlMnOpQrStUvWxYz
ANTHROPIC_API_KEY=

# ============================================================
# Seguridad
# ============================================================

# Clave interna para proteger los endpoints de gestion (/leads/*, /api/dashboard/*).
# Invéntala tú: una cadena aleatoria larga (genera una con `openssl rand -hex 32`
# o similar) y envíala en el header 'x-api-key'.
# Ejemplo de FORMATO: INTERNAL_API_KEY=3f9a1c7e2b5d8f0a4c6e9b2d5f8a1c4e7b0d3f6a9c2e5b8d1f4a7c0e3b6d9f2a
INTERNAL_API_KEY=cambia_este_valor

# ============================================================
# Configuracion
# ============================================================

# Puerto del servidor. En Railway lo asigna la plataforma automaticamente via la
# variable PORT — no hace falta fijarlo a mano ahi, este valor es solo para local.
PORT=3000

# Carpeta donde se persisten los datos (leads.json + leads.backup.json).
# Local: ./data (relativo, se crea solo). En Railway: crea un Volume y usa su ruta
# de montaje, normalmente /data, para que los leads sobrevivan a cada redeploy.
# Local:   DATA_PATH=./data
# Railway: DATA_PATH=/data
DATA_PATH=./data

# Nivel de log de pino: fatal | error | warn | info | debug | trace.
# En produccion, 'warn' reduce el ruido; 'info' (por defecto) es mas detallado y
# util mientras se depura el despliegue inicial.
LOG_LEVEL=info
